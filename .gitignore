# Root .gitignore for SpendWise

node_modules/
dist/
dist-ssr/
*.local

# Environment variables (Never commit secret API keys or service credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# Editor & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log

# Build temporary files
*.tmp
*.tsbuildinfo
